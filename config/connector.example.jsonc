// Connector: exposes local fixed routes and a SOCKS5 CONNECT listener.
// TOM_BATCH_KEY must be supplied in the process environment for aead.
{
  "role": "connector",
  "nodeId": "connector-a",
  "mqtt": {
    "url": "mqtts://broker.example.com:8883",
    "clientId": "connector-a",
    "topicPrefix": "$tenant/acme/prod",
    "protocolVersion": 5,
    "qos": 1,
    "usernameEnv": "MQTT_USERNAME",
    "passwordEnv": "MQTT_PASSWORD",
    "rejectUnauthorized": true
  },
  "protocols": { "tcp": true, "tls": true, "http": true, "socks": true },
  "batch": {
    "archive": "tgz",
    "protection": "aead",
    "keyEnv": "TOM_BATCH_KEY",
    "maxBatchBytes": 48000,
    "maxRecordsPerBatch": 64,
    "maxDelayMs": 2,
    "maxDecompressedBytes": 8388608,
    "maxCompressionRatio": 100
  },
  "tunnel": {
    "maxConcurrentTunnels": 1024,
    "maxBufferedBytesPerTunnel": 1048576,
    "idleTimeoutMs": 60000,
    "connectTimeoutMs": 10000
  },
  // Must be explicit. Empty means no generic tcp target restriction.
  "egress": { "allowedHosts": [], "allowedPorts": [], "denyPrivateNetworks": false },
  // Enabled protocol policies require both arrays. [] explicitly means unrestricted.
  "http": {
    "allowedHosts": ["api.example.com"],
    "allowedPorts": [80, 443],
    "denyPrivateNetworks": true,
    "requireHost": true,
    "requireEndpointHostMatch": true
  },
  "tls": {
    "allowedHosts": ["*.example.com"],
    "allowedPorts": [443],
    "denyPrivateNetworks": true,
    "requireSni": true,
    "requireEndpointSniMatch": true,
    "allowEch": false,
    "allowedEchPublicNames": [],
    "legacySsl": "reject"
  },
  "socks": {
    // Required even when unrestricted. Here the SOCKS exit may reach any host/port.
    "allowedHosts": [],
    "allowedPorts": [],
    "denyPrivateNetworks": true,
    "connectTimeoutMs": 10000
  },
  "listeners": [
    { "name": "internal-http", "type": "http", "listenHost": "127.0.0.1", "listenPort": 18080, "toNodeId": "server-a", "targetHost": "api.example.com", "targetPort": 80 },
    { "name": "dynamic-socks", "type": "socks", "listenHost": "127.0.0.1", "listenPort": 1080, "toNodeId": "server-a" }
  ]
}
