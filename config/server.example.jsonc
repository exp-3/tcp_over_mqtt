// Server/exitor counterpart. It can also host its own local listeners if desired.
// TOM_* environment variables override the fallback values below. If an
// environment variable is absent, its matching configuration value is used.
{
  "role": "server",
  "nodeId": "server-a",
  "mqtt": {
    "url": "mqtts://broker.example.com:8883",
    "clientId": "server-a",
    "topicPrefix": "$tenant/acme/prod",
    "protocolVersion": 5,
    "qos": 1,
    "username": "replace-with-mqtt-username",
    "password": "replace-with-mqtt-password",
    "usernameEnv": "TOM_MQTT_USERNAME",
    "passwordEnv": "TOM_MQTT_PASSWORD",
    "rejectUnauthorized": true
  },
  "protocols": { "tcp": true, "tls": true, "http": true, "socks": true },
  "batch": {
    "archive": "tgz",
    "protection": "aead",
    "key": "base64:replace-with-a-high-entropy-secret",
    "keyEnv": "TOM_BATCH_KEY",
    "maxBatchBytes": 512000,
    "maxRecordsPerBatch": 128,
    "maxDelayMs": 50,
    "minPublishIntervalMs": 5,
    "maxQueuedRecords": 4096,
    "maxDecompressedBytes": 8388608,
    "maxCompressionRatio": 100
  },
  "tunnel": {
    "maxConcurrentTunnels": 1024,
    "maxBufferedBytesPerTunnel": 1048576,
    "idleTimeoutMs": 60000,
    "connectTimeoutMs": 10000
  },
  "egress": { "allowedHosts": [], "allowedPorts": [], "denyPrivateNetworks": true },
  // HTTP policy applies to the fixed origin declared by each HTTP listener.
  // The connector rewrites client requests before the server connects upstream.
  "http": {
    "allowedHosts": ["api.example.com"],
    "allowedPorts": [80, 443],
    "denyPrivateNetworks": true,
    "requestHeaderMaxBytes": 65536,
    "requestHeaderTimeoutMs": 5000,
    "responseHeaderMaxBytes": 65536,
    "responseHeaderTimeoutMs": 5000
  },
  "tls": {
    "allowedHosts": ["*.example.com"],
    "allowedPorts": [443],
    "denyPrivateNetworks": true,
    "requireSni": true,
    "requireEndpointSniMatch": true,
    "allowEch": false,
    "allowedEchPublicNames": [],
    "legacySsl": "reject"
  },
  "socks": {
    "allowedHosts": [],
    "allowedPorts": [],
    "denyPrivateNetworks": true,
    "connectTimeoutMs": 10000
  },
  "listeners": []
}
